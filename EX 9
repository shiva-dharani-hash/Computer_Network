import socket 

dns_table = { 

    "google.com": "142.250.183.14", 

    "example.com": "93.184.216.34", 

    "openai.com": "104.18.33.45", 

    "yahoo.com": "98.137.11.163"} 

reverse_dns = {ip: domain for domain, ip in dns_table.items()} 

server_socket = socket.socket(socket.AF_INET, socket.SOCK_DGRAM) 

host = "127.0.0.1" 

port = 5000 

server_socket.bind((host, port)) 

print("DNS Server started...") 

print(f"Listening on {host}:{port}") 

while True: 

    data, client_address = server_socket.recvfrom(1024) 

    request = data.decode().strip() 

    parts = request.split(" ", 1) 

    if len(parts) != 2: 

        response = "Invalid request" 

    else: 

        lookup_type, query = parts 

        lookup_type = lookup_type.upper() 

        if lookup_type == "FORWARD" 

            response = dns_table.get(query, "Domain not found" 

        elif lookup_type == "REVERSE" 

            response = reverse_dns.get(query, "IP address not found") 

        else: 

            response = "Invalid lookup type" 

    server_socket.sendto(response.encode(), client_address) 

